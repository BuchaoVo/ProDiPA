{
  "baseline": "aspo_tpr_hf_compat",
  "display_name": "ASPO",
  "paradigm": "conditional",
  "condition": {
    "family_id": "G3DSA:1.25.40.10",
    "family_name": "Tetratricopeptide-like helical domain superfamily"
  },
  "method": {
    "mechanism": "multi-vector activation steering of the frozen ProLLaMA family prompt using an explicitly audited Hugging Face compatibility mapping",
    "implementation_label": "aspo_tpr_hf_compat",
    "compatibility_mapping": "released self_attn.head_out -> Hugging Face self_attn.o_proj; released mlp -> Hugging Face mlp",
    "vector_samples_per_class": 100,
    "steering_weights": {"fold": 0.5, "sol": 0.5, "thermo": 1.0},
    "negative_thresholds": {"fold": 70.0, "sol": 0.5, "thermo": 0.4}
  },
  "resources": {
    "official_repo": {
      "kind": "git_repo", "required": true,
      "commit": "f7da9960be1222957a18eeb1174126f3d6ed4940",
      "path": "third_party/Steering-PLMs"
    },
    "prollama_base": {"kind": "directory", "required": true, "path": "../../models/ProLLaMA"},
    "fold_positive_pool": {"kind": "file", "required": true, "path": "data/conditional/fold/train_plddt_300.json"},
    "sol_positive_pool": {"kind": "file", "required": true, "path": "data/conditional/sol/train_sol_300.json"},
    "thermo_positive_pool": {"kind": "file", "required": true, "path": "data/conditional/thermo/train_thermo_300.json"},
    "fold_negative_pool": {"kind": "file", "required": true, "path": "data/evaluation/conditional/requested_baselines/aspo_negative_pool/fold_low.json"},
    "sol_negative_pool": {"kind": "file", "required": true, "path": "data/evaluation/conditional/requested_baselines/aspo_negative_pool/sol_low.json"},
    "thermo_negative_pool": {"kind": "file", "required": true, "path": "data/evaluation/conditional/requested_baselines/aspo_negative_pool/thermo_low.json"},
    "homology_manifest": {"kind": "file", "required": true, "path": "data/evaluation/conditional/requested_baselines/aspo_negative_pool/homology_manifest.tsv"},
    "fold_vectors": {"kind": "file", "required": true, "path": "outputs/evaluation/conditional/requested_baselines/aspo_vectors/fold.pt"},
    "sol_vectors": {"kind": "file", "required": true, "path": "outputs/evaluation/conditional/requested_baselines/aspo_vectors/sol.pt"},
    "thermo_vectors": {"kind": "file", "required": true, "path": "outputs/evaluation/conditional/requested_baselines/aspo_vectors/thermo.pt"},
    "generation_entrypoint": {"kind": "file", "required": true, "path": "src/prodipa/baselines/aspo_prollama_hf.py"}
  },
  "protocol": {
    "requests": 512,
    "seed": 42,
    "temperature": 0.7,
    "top_p": 0.9,
    "top_k": 40,
    "repetition_penalty": 1.2,
    "max_new_tokens": 512,
    "output": "outputs/evaluation/conditional/baseline_generation/aspo_tpr_hf_compat.jsonl"
  }
}
