  "resources": {
    "official_repo": {"kind": "git_repo", "required": true, "commit_env": "LINEAGEFLOW_REPO_COMMIT", "path": "$LINEAGEFLOW_REPO"},
    "checkpoint": {"kind": "file", "required": true, "path": "$LINEAGEFLOW_CHECKPOINT"},
    "released_assets": {"kind": "directory", "required": true, "path": "$LINEAGEFLOW_ASSETS"},
    "verified_target_mapping": {"kind": "file", "required": true, "path": "$LINEAGEFLOW_TPR_MAPPING"},
    "generation_entrypoint": {"kind": "file", "required": true, "path": "$LINEAGEFLOW_TPR_ENTRYPOINT"}
  },
  "protocol": {"requests": 512, "seed": 42, "output": "outputs/evaluation/conditional/baseline_generation/lineageflow_tpr.jsonl"}
}
