{
  "baseline": "lineageflow_tpr",
  "display_name": "LineageFlow",
  "paradigm": "conditional",
  "condition": {
    "family_id": "G3DSA:1.25.40.10",
    "family_name": "Tetratricopeptide-like helical domain superfamily"
  },
  "method": {
    "mechanism": "family-aware Dirichlet flow matching from a released ASR lineage prior",
