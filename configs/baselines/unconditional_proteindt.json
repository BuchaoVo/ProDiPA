    "protein_model": {
      "kind": "file",
      "path": "$PROTEINDT_PRETRAINED_FOLDER/protein_model.pth"
    },
    "text_model": {
      "kind": "file",
      "path": "$PROTEINDT_PRETRAINED_FOLDER/text_model.pth"
    },
    "protein_projection": {
