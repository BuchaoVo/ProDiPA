    "novelty_u_ready_marker": "__PRODIPA_DATABASES__/uniprotkb/2026_03/READY",
    "novelty_t_fasta": "outputs/evaluation/references/conditional_train_union.fasta",
    "novelty_t_definition": "Union of Fold, Sol and Thermo 300-sequence conditional teacher training sets; identical reference for every compared method",
    "protrek_definition": "Cosine similarity between the frozen TPR text condition and generated protein in the frozen shared embedding space"
