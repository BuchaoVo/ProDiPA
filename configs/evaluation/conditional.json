{
  "schema_version": 1,
  "evaluation_name": "conditional",
  "requests_per_model": 512,
  "condition": {
    "instruction": "[Generate by superfamily]",
    "superfamily": "Tetratricopeptide-like helical domain superfamily",
    "prompt": "[Generate by superfamily] Superfamily=<Tetratricopeptide-like helical domain superfamily>",
    "family_database": "CATH-Gene3D",
    "family_id": "G3DSA:1.25.40.10"
  },
  "generation_protocol": {
    "scope": "Reference conditional autoregressive protocol; method-native decoders may differ but must preserve the frozen condition and record every request",
    "method_native_decode_allowed": true,
    "seed": 42,
    "temperature": 0.7,
    "top_p": 0.9,
    "top_k": 200,
    "repetition_penalty": 1.2,
    "max_new_tokens": 512,
    "valid_length_aa_min": 50,
    "valid_length_aa_max": 512
  },
  "references": {
    "ppl_model": "__PRODIPA_MODELS__/ProtGPT2",
    "novelty_u_label": "UniProtKB_2026_03",
